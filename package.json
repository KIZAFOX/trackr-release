{
  "name": "Trackr",
  "version": "0.1.0",
  "description": "Trackr c'est comme DPM.gg mais gratuit à 100%",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.kiza.trackr",
    "productName": "Trackr",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "**/*",
      "!node_modules/electron-builder/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KIZAFOX",
        "repo": "trackr-release",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}