{
  "name": "Trackr",
  "author": "KIZAFOX",
  "version": "0.1.1",
  "description": "Trackr c'est comme DPM.gg mais gratuit à 100%",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.kiza.trackr",
    "productName": "Trackr",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "assets/**/*",
      "dashboard/**/*",
      "main.js",
      "overlay/**/*",
      "package.json",
      "preload.js",
      "recorder/**/*",
      "src/**/*",
      "splash/**/*",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KIZAFOX",
        "repo": "trackr-release",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "electron-updater": "^6.8.9"
  }
}
